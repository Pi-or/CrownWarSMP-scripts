                execute console command "execute as @a at @s run playsound minecraft:entity.ender_dragon.growl master @s ~ ~ ~ 1 1"
            else if player's tool is not air:
                send "&c&l[!] &cThat's not an Enchanted Golden Apple in your main hand!" to player
            stop
            
        if {quest::BBC} is 7:
            if player's tool is air:
                send "&6&l[QUEST] &f""Bring me &b1 Elytra &fto sacrifice for immortal blood...""" to player
            if type of player's tool is elytra:
                if item amount of player's tool > 1:
