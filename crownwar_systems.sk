                else:
                    set player's tool to air
                set {quest::BBC} to 8
                set {beacon::locked::BBC::hearts} to true
                loop all players:
                    if {team::%loop-player's uuid%} is "BBC":
                        set max health of loop-player to 20
                broadcast "&d&l[👑 FACTION MILESTONE] &eTeam &lBCC &ehas completed &d&lUltimate Pinnacle: The Crown's Holder&e! Permanent +10 Hearts granted!"
                execute console command "execute as @a at @s run playsound minecraft:ui.toast.challenge_complete master @s ~ ~ ~ 1 1"
            else if player's tool is not air:
                send "&c&l[!] &cThat's not an Elytra in your main hand!" to player
            stop
            
        if {quest::BBC} is 8:
            send "&6&l[QUEST] &a""Your kingdom holds ultimate power over space and time. Destroy Team Bagmati!""" to player
            stop

    if {_name} contains "Bagmati":
        if {_team} is not "Bagmati":
            send "&c&l[!] &cThe Quest Giver glare freezes you. You do not belong to Team Bagmati!" to player
            stop
            
        if {quest::Bagmati} is not set:
