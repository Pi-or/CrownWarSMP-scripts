# ========================================================================
#                    CROWNWARSMP - master COMPLETION SYSTEM
# ========================================================================

# Combat balance: block End Crystal placement and Respawn Anchor placement/use.
on place of end crystal:
    cancel event
    send "&c&l[!] &cEnd Crystals are forbidden on CrownWarSMP in every dimension!" to player

on right click with end crystal:
    cancel event
    send "&c&l[!] &cEnd Crystals are forbidden on CrownWarSMP in every dimension!" to player

# A crystal already present in the world must not damage entities either.
on damage of ender crystal:
    cancel event

on explode:
    if event-entity is ender crystal:
        cancel event

on place of respawn anchor:
    cancel event
    send "&c&l[!] &cRespawn Anchors are forbidden on CrownWarSMP!" to player

on right click on respawn anchor:
    cancel event
    send "&c&l[!] &cRespawn Anchors are forbidden on CrownWarSMP!" to player

command /worldgate <text> <text>:
    permission: op
    permission message: &cOnly server Operators can modify the Dimensional Gates!
    trigger:
        if arg-1 is "open":
            if arg-2 is "nether":
                set {gate::nether} to true
                broadcast "&4&l[GATE] &eThe Nether Gate has been unsealed by the Gods!"
            else if arg-2 is "end":
                if {gate::nether} is not set:
                    send "&c&l[GATE] &cThe End cannot be opened while the Nether is sealed. Open the Nether gate first." to player
                    stop
                set {gate::end} to true
                broadcast "&5&l[GATE] &eThe End Gate has been unsealed by the Gods!"
            else:
                send "&cUsage: /worldgate <open|close> <nether|end>" to player
        else if arg-1 is "close":
            if arg-2 is "nether":
                clear {gate::nether}
                clear {gate::end}
                broadcast "&4&l[GATE] &cThe Nether Gate has been sealed!"
                broadcast "&5&l[GATE] &cThe End Gate has also been sealed because the Nether is closed!"
            else if arg-2 is "end":
                clear {gate::end}
                broadcast "&5&l[GATE] &cThe End Gate has been sealed!"
            else:
                send "&cUsage: /worldgate <open|close> <nether|end>" to player
        else:
            send "&cUsage: /worldgate <open|close> <nether|end>" to player

# Check the destination world, not the player's current world.
# The old logic checked the source world, so it only blocked trips OUT of a dimension.
on player portal:
    if environment of world of event-location is nether:
        if {gate::nether} is not set:
            cancel event
            send title "&c&lGATE SEALED" with subtitle "&7The Nether is locked for the first 5 days." to player
    else if environment of world of event-location is the end:
        if {gate::end} is not set:
            cancel event
            send title "&c&lGATE SEALED" with subtitle "&7The End is locked for the first 5 days." to player

# Also catch ender-pearl teleportation through a portal and any other teleport into a sealed dimension.
on teleport:
    if event-entity is a player:
        if world of event-location is not world of event-entity:
            if environment of world of event-location is nether:
                if {gate::nether} is not set:
                    cancel event
                    send title "&c&lGATE SEALED" with subtitle "&7The Nether is locked for the first 5 days." to event-entity
            else if environment of world of event-location is the end:
                if {gate::end} is not set:
                    cancel event
                    send title "&c&lGATE SEALED" with subtitle "&7The End is locked for the first 5 days." to event-entity

on right click on villager:
    set {_name} to name of targeted entity
    if {_name} contains "BCC":
        cancel event
        if {quest::click-lock::%player's uuid%} is set:
            stop
        set {quest::click-lock::%player's uuid%} to true
        wait 2 ticks
        clear {quest::click-lock::%player's uuid%}
    else if {_name} contains "Bagmati":
        cancel event
        if {quest::click-lock::%player's uuid%} is set:
            stop
        set {quest::click-lock::%player's uuid%} to true
        wait 2 ticks
        clear {quest::click-lock::%player's uuid%}
    set {_team} to {team::%player's uuid%}
    
    if {_name} contains "BCC":
        if {_team} is not "BBC":
            send "&c&l[!] &cThe Quest Giver glare freezes you. You do not belong to Team BCC!" to player
            stop
            
        if {quest::BBC} is not set:
            set {quest::BBC} to 1
            
        if {quest::BBC} is 1:
            if player's tool is air:
                send "&6&l[QUEST] &f""Bring me &b1 Diamond Block &fto unlock the path of swiftness...""" to player
            if type of player's tool is diamond block:
                if item amount of player's tool > 1:
                    set player's tool to (item amount of player's tool - 1) of player's tool
                else:
                    set player's tool to air
                set {quest::BBC} to 2
                set {beacon::locked::BBC::speed} to true
                broadcast "&e&l[QUEST COMPLETE] &fTeam &lBCC &fcompleted Quest 1! &e&lSPEED 1 &fis active globally forever!"
                execute console command "execute as @a at @s run playsound minecraft:ui.toast.challenge_complete master @s ~ ~ ~ 1 1"
            else if player's tool is not air:
                send "&c&l[!] &cThat's not a Diamond Block in your main hand!" to player
            stop
            
        if {quest::BBC} is 2:
            if player's tool is air:
                send "&6&l[QUEST] &f""Bring me &b1 Heart of the Sea &fto harden your defenses...""" to player
            if type of player's tool is heart of the sea:
                if item amount of player's tool > 1:
                    set player's tool to (item amount of player's tool - 1) of player's tool
                else:
                    set player's tool to air
                set {quest::BBC} to 3
                set {beacon::locked::BBC::resistance} to true
                broadcast "&e&l[QUEST COMPLETE] &fTeam &lBCC &fcompleted Quest 2! &e&lRESISTANCE 1 &fis active globally forever!"
                execute console command "execute as @a at @s run playsound minecraft:ui.toast.challenge_complete master @s ~ ~ ~ 1 1"
            else if player's tool is not air:
                send "&c&l[!] &cThat's not a Heart of the Sea in your main hand!" to player
            stop
            
        if {quest::BBC} is 3:
            if player's tool is air:
                send "&6&l[QUEST] &f""Bring me &b1 Mending Book &fto finish the first tier!""" to player
            if player's tool is an enchanted book:
                if stored enchants of player's tool contains mending:
                    set player's tool to air
                    set {quest::BBC} to 4
                    set {beacon::locked::BBC::haste} to true
                    broadcast "&d&l[👑 FACTION MILESTONE] &eTeam &lBCC &ehas unlocked &a&lThe Foundation &eand moved to &c&lThe Ascension&e!"
                    execute console command "execute as @a at @s run playsound minecraft:entity.ender_dragon.growl master @s ~ ~ ~ 1 1"
                else:
                    send "&c&l[!] &cThat's not a Mending Book in your main hand!" to player
            else if player's tool is not air:
                send "&c&l[!] &cThat's not a Mending Book in your main hand!" to player
            stop
            
        if {quest::BBC} is 4:
            if player's tool is air:
                send "&6&l[QUEST] &f""Bring me &b1 Netherite Ingot &fto conquer the elemental fires...""" to player
            if type of player's tool is netherite ingot:
                if item amount of player's tool > 1:
                    set player's tool to (item amount of player's tool - 1) of player's tool
                else:
                    set player's tool to air
                set {quest::BBC} to 5
