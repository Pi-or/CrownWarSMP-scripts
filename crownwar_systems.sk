on join:
    set {_t} to {team::%player's uuid%}
    if {beacon::locked::%{_t}%::hearts} is true:
        set max health of player to 20
    else:
        set max health of player to 10

every 3 seconds:
    loop all players:
        set {_t} to {team::%loop-player's uuid%}
        if {beacon::locked::%{_t}%::strength} is true:
            execute console command "effect give %loop-player% minecraft:strength 6 0 true"
        if {beacon::locked::%{_t}%::fireresist} is true:
            execute console command "effect give %loop-player% minecraft:fire_resistance 6 0 true"
        if {beacon::locked::%{_t}%::speed2} is true:
            execute console command "effect give %loop-player% minecraft:speed 6 1 true"
        else if {beacon::locked::%{_t}%::speed} is true:
            execute console command "effect give %loop-player% minecraft:speed 6 0 true"
        if {beacon::locked::%{_t}%::resistance} is true:
            execute console command "effect give %loop-player% minecraft:resistance 6 0 true"
        if {beacon::locked::%{_t}%::haste} is true:
            execute console command "effect give %loop-player% minecraft:haste 6 0 true"

on death of player:
    set {_v_team} to {team::%victim's uuid%}
    set {_k_team} to {team::%attacker's uuid%}
    if {_v_team} is set:
        if {_k_team} is set:
            if {_v_team} is not {_k_team}:
                if {bounty::%victim's uuid%} is true:
                    clear {bounty::%victim's uuid%}
                    clear {kills::%victim's uuid%}
                    broadcast "&e&l[BOUNTY CLAIMED] &f%attacker% killed the legendary %victim% and won an &6&lEnchanted Golden Apple&f!"
                    drop 1 enchanted golden apple at location of victim
                    stop
                add 1 to {kills::%attacker's uuid%}
                if {kills::%attacker's uuid%} is 3:
                    set {bounty::%attacker's uuid%} to true
                    broadcast "&4&l[BOUNTY RUN] &e%attacker% from Team %{_k_team}% is on a 3-Kill Rampage! Kill them to steal a God Apple!"

command /resetbuffs:
    permission: op
    trigger:
        clear {beacon::locked::BBC::speed}
        clear {beacon::locked::BBC::resistance}
        clear {beacon::locked::BBC::haste}
        clear {beacon::locked::BBC::speed2}
        clear {beacon::locked::BBC::strength}
        clear {beacon::locked::BBC::fireresist}
        clear {beacon::locked::BBC::hearts}
        clear {beacon::locked::Bagmati::speed}
        clear {beacon::locked::Bagmati::resistance}
        clear {beacon::locked::Bagmati::haste}
        clear {beacon::locked::Bagmati::speed2}
        clear {beacon::locked::Bagmati::strength}
        clear {beacon::locked::Bagmati::fireresist}
        clear {beacon::locked::Bagmati::hearts}
        clear {quest::BBC}
        clear {quest::Bagmati}
        loop all players:
            set max health of loop-player to 10
        send "&a&l[ADMIN] &aAll permanent kingdom buffs and tier progression data have been completely wiped!" to player

command /resetplayerteam <player>:
    permission: op
    trigger:
        set {_p} to arg-1
        clear {team::%{_p}'s uuid%}
        clear {hq::%{_p}'s uuid%}
        set max health of {_p} to 10
        set {_p}'s display name to name of {_p}
        execute console command "team leave %name of {_p}%"
        send "&a&l[ADMIN] &aSuccessfully wiped team, HQ spawn tags, and prefixes for %{_p}%!" to player
        send "&c&l[!] &cAn administrator has reset your team data. Use /joinbcc or /joinbagmati to re-align!" to {_p}

command /setbcchq:
    trigger:
        if {team::%player's uuid%} is not "BBC":
            send "&c&l[!] &cYou do not belong to Team BCC! You cannot alter their base grid." to player
            stop
        set {_loc} to location of player
        set {_spawn} to location(0, 73, 0, world of player)
        if distance between {_loc} and {_spawn} is less than 100:
            send "&c&l[!] &cThe cosmic altar rejects this location! Bases cannot be built inside the 100x100 Spawn Region." to player
            stop
        if {hq::location::Bagmati} is set:
            if distance between {_loc} and {hq::location::Bagmati} is less than 100:
                send "&c&l[!] &cToo close to enemy territory! You must build your HQ at least 100 blocks away from Bagmati's base." to player
                stop
        set {hq::location::BBC} to {_loc}
        loop all players:
            if {team::%loop-player's uuid%} is "BBC":
                set {hq::%loop-player's uuid%} to {hq::location::BBC}
                send "&e&l[HQ RELOCATION] &f%player% has re-anchored &eTeam BCC's HQ &fto your current coordinates!" to loop-player

command /setbagmatihq:
    trigger:
        if {team::%player's uuid%} is not "Bagmati":
            send "&c&l[!] &cYou do not belong to Team Bagmati! You cannot alter their base grid." to player
            stop
        set {_loc} to location of player
        set {_spawn} to location(0, 73, 0, world of player)
        if distance between {_loc} and {_spawn} is less than 100:
            send "&c&l[!] &cThe cosmic altar rejects this location! Bases cannot be built inside the 100x100 Spawn Region." to player
            stop
        if {hq::location::BBC} is set:
            if distance between {_loc} and {hq::location::BBC} is less than 100:
                send "&c&l[!] &cToo close to enemy territory! You must build your HQ at least 100 blocks away from BCC's base." to player
                stop
        set {hq::location::Bagmati} to {_loc}
        loop all players:
            if {team::%loop-player's uuid%} is "Bagmati":
                set {hq::%loop-player's uuid%} to {hq::location::Bagmati}
                send "&e&l[HQ RELOCATION] &f%player% has re-anchored &eTeam Bagmati's HQ &fto your current coordinates!" to loop-player

command /setbccmover:
    trigger:
        if {team::%player's uuid%} is not "BBC":
            send "&c&l[!] &cYou do not belong to Team BCC! You cannot relocate their Quest Giver." to player
            stop
        set {_loc} to location of player
        loop all villagers:
            if name of loop-villager contains "BCC":
                teleport loop-villager to {_loc}
                set {quest_giver::loc::BBC} to {_loc}
                set {_found} to true
        if {_found} is true:
            loop all players:
                if {team::%loop-player's uuid%} is "BBC":
                    send "&e&l[NPC MOVED] &f%player% has relocated &eBCC's Quest Giver &fto your current position!" to loop-player
                    play sound "entity.enderman.teleport" with volume 0.8 and pitch 1 to loop-player
        else:
            send "&c&l[!] &cQuest Giver entity not found in loaded chunks! Make sure it has been summoned at least once on the server." to player

command /setbagmatimover:
    trigger:
        if {team::%player's uuid%} is not "Bagmati":
            send "&c&l[!] &cYou do not belong to Team Bagmati! You cannot relocate their Quest Giver." to player
            stop
        set {_loc} to location of player
        loop all villagers:
            if name of loop-villager contains "Bagmati's Quest Giver":
                teleport loop-villager to {_loc}
                set {quest_giver::loc::Bagmati} to {_loc}
                set {_found} to true
        if {_found} is true:
            loop all players:
                if {team::%loop-player's uuid%} is "Bagmati":
                    send "&e&l[NPC MOVED] &f%player% has relocated &eBagmati's Quest Giver &fto your current position!" to loop-player
                    play sound "entity.enderman.teleport" with volume 0.8 and pitch 1 to loop-player
        else:
            send "&c&l[!] &cQuest Giver entity not found in loaded chunks! Make sure it has been summoned at least once on the server." to player
